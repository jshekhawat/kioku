# ---- Chat / reasoning model -------------------------------------------------
# provider: openrouter | ollama | openai (any OpenAI-compatible server)
KIOKU_LLM_PROVIDER=openrouter
KIOKU_LLM_MODEL=openai/gpt-4o-mini

# OpenRouter credentials (https://openrouter.ai/keys)
KIOKU_OPENROUTER_API_KEY=sk-or-v1-...
# Optional, shown in your OpenRouter dashboard:
# KIOKU_OPENROUTER_REFERER=https://github.com/you/kioku
# KIOKU_OPENROUTER_TITLE=kioku

# Fully local chat model alternative (Ollama):
# KIOKU_LLM_PROVIDER=ollama
# KIOKU_LLM_MODEL=llama3.2

# ---- Ollama (embeddings, and optionally chat) -------------------------------
# Default: an Ollama that is NOT part of this compose project -- either running
# on the host or in another container. On Linux host.docker.internal is mapped
# to the host gateway for you.
KIOKU_OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# Use the Ollama bundled in this compose file instead:
#   KIOKU_OLLAMA_BASE_URL=http://ollama:11434
#   docker compose --profile bundled-ollama up -d
#
# Use an Ollama container on a separate Docker network via the override file:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.external-ollama.yml
#   KIOKU_OLLAMA_NETWORK=my-net                    # network your Ollama is on
#   KIOKU_OLLAMA_BASE_URL=http://my-ollama:11434   # its container name

# ---- Embeddings -------------------------------------------------------------
# Ollama keeps embeddings local and free.
KIOKU_EMBED_PROVIDER=ollama
KIOKU_EMBED_MODEL=nomic-embed-text
KIOKU_EMBED_DIM=768

# ---- Stores -----------------------------------------------------------------
# KIOKU_QDRANT_URL=http://qdrant:6333
# KIOKU_FALKORDB_HOST=falkordb
KIOKU_GRAPH_ENABLED=true
# Recreate the Qdrant collection automatically when KIOKU_EMBED_DIM changes
# (destructive: drops existing memories). Default false fails fast at startup.
# KIOKU_QDRANT_RECREATE_ON_DIM_MISMATCH=false

# ---- Behaviour --------------------------------------------------------------
# KIOKU_SIMILARITY_THRESHOLD=0.1
# KIOKU_LOG_LEVEL=INFO
